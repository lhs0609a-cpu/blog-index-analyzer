# Python cache - 이전 버전의 .pyc 파일이 복사되는 것 방지
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Virtual environment
venv/
.venv/
env/
.env.local

# IDE
.vscode/
.idea/

# Git
.git/
.gitignore

# Test files
test_*.json
*.test.py
pytest_cache/
.pytest_cache/

# Misc
*.log
*.tmp

# ===== 세션 스크래치 산출물 =====
# Dockerfile 이 `COPY . .` 이라 여기 있는 건 전부 프로덕션 이미지에 실린다.
# (2026-08-24) 이 디렉터리에 쌓인 `_`-접두 분석 산출물이 빌드 컨텍스트를 63MB 로
# 불려 놓아서, 구글 드라이브 가상 FS 에서 읽는 데 19분이 걸리고 도중에
# I/O abort 로 배포가 실패했다. 앱은 이 파일들을 읽지 않는다.
# .py 는 남긴다(작고, 임포트 관계를 다 확인하기 전엔 지우지 않는다).
_*.json
_*.csv
_*.err
_*.log
_*.txt
_*.md
_*.sh
_*.xlsx
_*.png
_*.tmp.*
_*_out/
_*_data/
